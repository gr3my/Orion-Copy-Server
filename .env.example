# ─────────────────────────────────────────────────────────────────────────────
# Orion Copy Server configuration — every deployment-specific value lives here.
# Copy to `.env` and edit, then run the installer:
#
#   Windows:  Copy-Item .env.example .env ; notepad .env ; .\install.ps1
#   Linux:    cp .env.example .env && nano .env && sudo ./install.sh
#
# Nothing else should need editing for a normal deploy.
# NEVER commit `.env` — it holds real secrets. Only `.env.example` is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment mode ─────────────────────────────────────────────────────────
# Development (default): frictionless, warnings only.
# Production: strict startup validation — real secrets (16+ chars), debug
# endpoints off, attestation fail-open off, insecure mode off. The backend
# REFUSES to start until production config is valid.
ORION_ENVIRONMENT=Development

# ── Network binding ──────────────────────────────────────────────────────────
# Client-facing services (Mothership :90, StationDb :78, EOS :50, EOS-WS :80)
# listen on ORION_PUBLIC_BIND; management services (dashboard :8080,
# orchestrator :9095, UI :3000) always stay on ORION_INTERNAL_BIND.
# Both default to loopback. The reverse proxy / tunnel on the same host reaches
# the backend over loopback, so defaults are correct for standard installs.
# Set ORION_PUBLIC_BIND=0.0.0.0 ONLY when remote hosts must reach the backend
# directly: split deployments (game servers on other boxes) or raw-IP mode
# without a domain. Combine with strict firewall rules (see docs/PORTS.md).
# ORION_HTTP_BIND remains as a legacy single-knob fallback for both.
ORION_PUBLIC_BIND=127.0.0.1
ORION_INTERNAL_BIND=127.0.0.1
# Legacy single knob (fallback for both binds above when they are unset):
# ORION_HTTP_BIND=127.0.0.1

# StationDb (:78) reachability. Port 78 carries open game-server self-registration
# and MUST NOT be Internet-exposed. Default closed.
#   ORION_EXPOSE_STATIONDB=0  port 78 stays private (single-box / proxied only)
#   ORION_EXPOSE_STATIONDB=1  allow remote game servers to reach :78
# When exposing, optionally scope to a CIDR or IP (e.g. 10.0.0.0/8 or
# 203.0.113.10). Empty = any remote address (not recommended).
ORION_EXPOSE_STATIONDB=0
ORION_STATIONDB_CIDR=

# Optional extra gate on self-registration (default off = open, payload-compatible).
# Enable ONLY after confirming your payloads send x-server-api-key on
# POST /register_server (check the backend log); otherwise servers can't register.
ORION_REQUIRE_REGISTRATION_KEY=false

# Agent-hub bind (orchestrator :9100). Same rule: loopback for single-box;
# LAN IP / 0.0.0.0 only when agents run elsewhere, firewalled to those hosts.
# Remote agents authenticate with ORION_AGENT_KEY; loopback skips it.
ORION_AGENT_BIND=127.0.0.1

# Honor proxy forwarding headers (CF-Connecting-IP, X-Real-IP, X-Forwarded-For)
# for client-IP decisions. Default false (use the socket address). Enable ONLY
# when actually behind a trusted reverse proxy; otherwise clients can spoof IPs.
ORION_TRUST_PROXY_HEADERS=false

# Cap on concurrent in-flight HTTP requests per backend service (1-1024).
ORION_HTTP_CONCURRENCY=64

# ── Identity of THIS server ──────────────────────────────────────────────────
# Public IP or hostname clients reach. Must be reachable from the internet.
# Find it with:  curl -4 ifconfig.me
ORION_PUBLIC_HOST=YOUR_PUBLIC_HOSTNAME

# Optional domain. Leave blank to run on the raw IP (no TLS).
# If set, the installer configures Caddy + Let's Encrypt on :443 and you must
# point these DNS A records at ORION_PUBLIC_HOST first:
#   orion-ms.<domain>   orion.<domain>   orion-eos.<domain>
#
# NOTE: the in-game dashboard URL is patched in place inside the client and must
# stay <= 26 characters including "https://". Keep this domain short, e.g.:
#   https://orion.example.com  (25 chars -- fits)
ORION_DOMAIN=

# Public origin handed to headsets for board/info URLs (StationDb fallback).
# Defaults to https://orion.<ORION_DOMAIN>; set explicitly for split setups.
ORION_PUBLIC_ORIGIN=

# EOS gateway public host served to clients in the endpoint table
# (/sdk/v1/default). Usually orion-eos.<ORION_DOMAIN>, or the raw IP for LAN.
# The installer fills this in; you only need it for unusual layouts.
ORION_EOS_HOST=

# -- Reverse-proxy tunnel (alternative to ORION_DOMAIN/Caddy) ------------------
# Use this INSTEAD of a domain if your orion-* hostnames are already routed
# through a tunnel (e.g. cloudflared). The tunnel terminates TLS on 443 and
# reaches the backend over loopback, so NO inbound service ports need opening.
# Leave both blank to skip tunnel setup.
TUNNEL_NAME=
TUNNEL_CREDENTIALS=

# ── Shared secrets ───────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
# The installer REFUSES to run while any required key is still a placeholder.

# Backend <-> game-server shared secret (game servers send it as -ServerApiKey).
# Also gates orchestrator control-plane mutations from remote callers.
ORION_SERVER_API_KEY=CHANGE_ME

# Allocator-agent wire credential (:9100). Loopback agents skip it; REMOTE agents
# must present it in hello.key. The installers generate a value automatically.
ORION_AGENT_KEY=CHANGE_ME

# StationDb dashboard key (game servers send it as -DashboardApiKey).
# Must match ORION_DASHBOARD_API_KEY in the backend environment.
ORION_DASHBOARD_API_KEY=CHANGE_ME

# Dashboard admin key (browser login + x-dashboard-key header for scripts).
ORION_DASHBOARD_ADMIN_KEY=CHANGE_ME

# Dashboard session HMAC secret (signs the operator session cookie).
# Falls back to the admin key when unset.
ORION_DASHBOARD_SESSION_SECRET=CHANGE_ME

# Optional extra full-access dashboard keys (comma-separated, 16+ chars each).
ORION_DASHBOARD_EXTRA_KEYS=

# Dashboard backend origins (loopback defaults match the installers).
ORION_DASHBOARD_API_ORIGIN=http://127.0.0.1:8080
ORION_STATIONDB_ORIGIN=http://127.0.0.1:78

# Automation key for server-only routes (x-automation-key). Scoped separately
# from ORION_SERVER_API_KEY so tooling and game servers can be rotated apart.
ORION_AUTOMATION_KEY=CHANGE_ME

# Player JWT signing secret. If left as CHANGE_ME the backend generates a random
# one per run (sessions don't survive restarts) and logs a warning.
ORION_JWT_SECRET=CHANGE_ME

# Minted user/service API-key signing secret. Same ephemeral fallback behavior.
ORION_APIKEY_SIGNING_SECRET=CHANGE_ME

# Local production database file password. The installers GENERATE a strong value
# automatically when this is still a placeholder and persist it into .env.
# Production refuses to start without a real password (no fixed fallback exists).
ORION_DB_PASSWORD=CHANGE_ME

# ── Meta / platform app credentials (player login attestation) ───────────────
# From the Meta Developer Dashboard for YOUR app. Required for real client
# logins; while unset, attestation cannot pass and logins are denied (fail safe).
ORION_META_APP_ID=YOUR_META_APP_ID
ORION_META_APP_SECRET=YOUR_META_APP_SECRET

# Optional second (PC) Meta app + federated app. Leave empty if unused.
ORION_RIFT_APP_ID=
ORION_RIFT_APP_SECRET=
ORION_RIFT_FED_APP_ID=
ORION_RIFT_FED_APP_SECRET=

# Shared PC-flow identity (opaque deployment-scoped strings, not accounts).
ORION_RIFT_EXTERNAL_ID=
ORION_RIFT_ORG_SCOPED_ID=

# Shared-identity mode puts EVERY PC player under one identity (compatibility /
# development-only: the PC flow has no per-user attestation channel here).
# Default false (shared logins refused with a clear error). Enable explicitly
# only for PC fleets that accept this; production logs a loud warning.
ORION_ALLOW_SHARED_PC_IDENTITY=false

# Deployment identifiers echoed in auth responses (opaque strings).
ORION_ENVIRONMENT_ID=
ORION_TENANT_ID=

# Fail CLOSED on provider verification errors (default). Set to true ONLY for
# local development when the attestation provider is unreachable; never public.
ORION_ALLOW_ATTESTATION_FAIL_OPEN=false

# Auth log verbosity (default false: success/failure lines only). Set to true
# ONLY for local attestation debugging; nonce/proof/certificate diagnostics are
# DEVELOPMENT ONLY and must never log on a public server.
ORION_VERBOSE_AUTH_LOGGING=false

# Optional Meta organization ID for dashboard SSO. Leave empty to use the
# admin-key header instead of Meta sign-in.
ORION_META_ORG_ID=

# Where the dashboard UI is served from (must be registered as the SSO
# redirect_uri origin when Meta SSO is used).
ORION_DASHBOARD_ORIGIN=http://localhost:3000

# The package + signing cert of YOUR client build (verified during attestation).
# Empty = skip that pin (not recommended for public servers). Example package:
# com.example.orioncopy
ORION_META_PACKAGE_NAME=
ORION_META_CERT_SHA256=

# ── EOS-compatible gateway identity ────────────────────────────────────────
# Served to clients in tokens and the endpoint table. Placeholders fall back to
# clearly-marked template defaults; set real values for your deployment.
ORION_EOS_PRODUCT_ID=YOUR_EOS_PRODUCT_ID
ORION_EOS_SANDBOX_ID=YOUR_EOS_SANDBOX_ID
ORION_EOS_DEPLOYMENT_ID=YOUR_EOS_DEPLOYMENT_ID
ORION_EOS_ORG_ID=YOUR_EOS_ORG_ID
ORION_EOS_CLIENT_ID=YOUR_EOS_CLIENT_ID

# ── Voice (RTC) provider ─────────────────────────────────────────────────────
# When unset, room issuance refuses instead of minting against placeholders.
ORION_RTC_URL=wss://YOUR_RTC_HOST
ORION_RTC_API_KEY=YOUR_RTC_API_KEY
ORION_RTC_SECRET=YOUR_RTC_SECRET

# ── TURN server ────────────────────────────────────────────────────────────
# When unset, TURN credentials refuse; the endpoint table keeps a token host
# so clients fail loudly instead of reaching a wrong server.
ORION_TURN_HOST=YOUR_TURN_HOST
ORION_TURN_PORT=3478
ORION_TURN_SECRET=YOUR_TURN_SECRET

# ── Game build ───────────────────────────────────────────────────────────────
# MUST equal the client build or every station is filtered out of the browser.
ORION_BUILD_VERSION=22284

# ── Admins ─────────────────────────────────────────────────────────────────
# Comma-separated account IDs granted global admin on every station.
# DEFAULT IS EMPTY (no bootstrap admins). Placeholder values are ignored.
ORION_BOOTSTRAP_ADMIN_IDS=

# ── Debug endpoints ────────────────────────────────────────────────────────
# /debug/storage and friends. Default false (disabled). Dev only.
ORION_ENABLE_DEBUG_ENDPOINTS=false

# ── Ports (defaults match the backend bindings) ──────────────────────────────
ORION_BACKEND_PORT_MOTHERSHIP=90     # login/auth
ORION_BACKEND_PORT_STATIONDB=78      # stations/roles/deployments
ORION_BACKEND_PORT_EOS=50            # EOS gateway (server list)
ORION_BACKEND_PORT_EOS_WS=80         # EOS websocket
ORION_BACKEND_PORT_DASHBOARD=8080    # backend's own web dashboard + control API
ORION_BACKEND_PORT_DASHBOARD_UI=3000 # Next.js UI (loopback only)
ORION_BACKEND_PORT_ORCH_CTL=9095     # orchestrator control (never public)
ORION_BACKEND_PORT_ORCH_AGENT=9100   # orchestrator agent TCP (never public)
ORION_GAME_UDP_FIRST=7777            # game servers; opens FIRST..LAST
ORION_GAME_UDP_LAST=7787

# 1 = install + build the Next.js dashboard UI and run it at startup.
# Needs Node.js 20+. 0 = skip it; the backend's own dashboard still works.
ORION_INSTALL_DASHBOARD_UI=1

# ── Security ─────────────────────────────────────────────────────────────────
# 1 = installer manages the firewall (public: 443/tcp + game UDP range only).
# 0 = leave the firewall alone (NOT recommended on a public host).
ORION_MANAGE_FIREWALL=1

# NEVER set these to 1 on a public server. Dev/LAN only.
# ORION_INSECURE=1 disables ALL identity checks (full auth bypass).
# ORION_ALLOW_NONSTORE=1 lets sideloaded (non-store) clients log in.
ORION_INSECURE=0
ORION_ALLOW_NONSTORE=0
# ORION_SELF_ELEVATE=1 restores auto-elevation on boxes without urlacl reservations.
# Leave unset (0) normally.
ORION_SELF_ELEVATE=0

# ── Runtime ──────────────────────────────────────────────────────────────────
ORION_INSTALL_DIR=/opt/orion-copy-server
ORION_SERVICE_USER=orion-copy-server
