# Orion Copy Server Dashboard — local configuration.
# Copy to `.env.local` (gitignored) for development. Production values come from
# the repo-root `.env` via the installers (run/dashboard-ui.cmd, backend.env).
#
#   Copy-Item .env.example .env.local   # then edit

# Operator master key (canonical). Generate: openssl rand -hex 32
ORION_DASHBOARD_ADMIN_KEY=CHANGE_ME

# Session HMAC secret. Falls back to the admin key when unset.
ORION_DASHBOARD_SESSION_SECRET=CHANGE_ME

# Optional extra full-access keys (comma-separated, 16+ chars each).
ORION_DASHBOARD_EXTRA_KEYS=

# Backend origins (loopback defaults match install.ps1/install.sh layouts).
ORION_DASHBOARD_API_ORIGIN=http://127.0.0.1:8080
ORION_STATIONDB_ORIGIN=http://127.0.0.1:78

# Key the dashboard uses for StationDb (:78) calls. Must equal the backend's
# ORION_DASHBOARD_API_KEY.
ORION_DASHBOARD_API_KEY=CHANGE_ME

# Optional Redis (Upstash/Vercel KV compatible) for persistent operator-key
# registry + audit log. Without it, scoped keys still work but revocation and
# audit history are not persisted across restarts.
OPERATOR_STORE_REST_URL=
OPERATOR_STORE_REST_TOKEN=
# Provider-specific fallbacks (same values, different names):
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL= / KV_REST_API_TOKEN=
